<div class="form-screen">
  <div class="text-center">
    <h2>Scouting Info</h2>
    <p class="form-subtitle mt-4">Tell us who you are before scouting</p>
  </div>

  <div class="form-fields">
    <div>
      <div class="form-field-label">First Name</div>
      <input type="text" class="first-name" placeholder="e.g. Alex" autocomplete="given-name" />
    </div>
    <div>
      <div class="form-field-label">Last Name</div>
      <input type="text" class="last-name" placeholder="e.g. Smith" autocomplete="family-name" />
    </div>
    <div>
      <div class="form-field-label">Match Number</div>
      <input type="number" class="match-number" placeholder="1" min="1" />
    </div>
    <div>
      <div class="form-field-label">Robot Number</div>
      <input type="text" class="robot-number" placeholder="3061" />
    </div>
  </div>

  <button class="form-save-btn save">Start Scouting →</button>
</div>

<script src="/js/form.js"></script>
