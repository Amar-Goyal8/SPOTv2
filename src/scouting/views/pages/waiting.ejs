<div class="waiting-screen">
  <div class="waiting-spinner-wrap">
    <div class="waiting-spinner"></div>
    <div class="waiting-icon"><i class="fa-solid fa-crosshairs"></i></div>
  </div>

  <div>
    <div class="waiting-title">Waiting for match assignment...</div>
    <div class="waiting-sub mt-4">The admin will assign you a robot soon</div>
  </div>

  <div class="waiting-hint">
    <strong>Tip:</strong> Make sure your screen stays on — you'll be notified automatically when the match starts.
  </div>

  <div class="stat-grid" style="max-width:320px;width:100%">
    <div class="stat-block">
      <div class="stat-value" id="wait-matches">–</div>
      <div class="stat-label">Matches Scouted</div>
    </div>
    <div class="stat-block">
      <div class="stat-value" id="wait-level">–</div>
      <div class="stat-label">Level</div>
    </div>
  </div>
</div>

<script src="/js/waiting.js"></script>
